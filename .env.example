# Safe default: loopback-only, Demo Mode only.
HOST=127.0.0.1
PORT=3000

# Required for Live Mode. Generate with: openssl rand -hex 32
QUORUMLATCH_CONTROL_TOKEN=
# Required as an explicit assertion when HOST is not loopback.
QUORUMLATCH_TLS_TERMINATED=false
# Required for non-loopback deployments. Exact comma-separated HTTPS origins.
QUORUMLATCH_ALLOWED_ORIGINS=
ASSEMBLYAI_API_KEY=
LLM_GATEWAY_MODEL=qwen3.5-4b-32k-fast

# Optional stable receipt-signing key. Generate with: openssl rand -hex 32
QUORUMLATCH_RECEIPT_KEY=

# Hackathon-only signed actuator simulator. It verifies the real HMAC capsule,
# enforces TTL and idempotency, but can never control physical hardware.
QUORUMLATCH_ENABLE_SIGNED_MOCK_RECEIVER=false
QUORUMLATCH_MOCK_RECEIVER_SECRET=

# Exact comma-separated HTTPS hosts that may receive unlock webhooks.
# Empty means real webhooks are forbidden.
QUORUMLATCH_WEBHOOK_HOSTS=
